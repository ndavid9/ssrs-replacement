@model LabReport.Core.Rendering.RenderPlan
<section class="block insert-list" id="insert-list">
    <h2>Inserted documents</h2>
    <p class="prose">Page counts are the uploaded PDFs and are known before those files are merged. Appendix pages continue the report page count. Their ranges are written into the reserved cells after the slot pages have been located. Attachment pages keep their original content and are not part of that count.</p>
    <table class="grid">
        <thead>
            <tr>
                <th>Insert</th>
                <th>Kind</th>
                <th>Pages</th>
                <th>Orientation</th>
                <th>Report pages</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var insert in Model.Inserts)
            {
                <tr>
                    <td>@insert.Label</td>
                    <td>@(insert.Mode == LabReport.Core.Models.PdfInsertMode.Appendix ? "Appendix" : "Attachment")</td>
                    <td>@insert.PageCount</td>
                    <td>@insert.OrientationText</td>
                    <td>
                        @if (insert.Mode == LabReport.Core.Models.PdfInsertMode.Appendix)
                        {
                            <span class="appendix-range">@insert.RangeToken</span>
                        }
                        else
                        {
                            <span>Not numbered</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
